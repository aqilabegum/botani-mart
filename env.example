# ============================================
# Botani Mart - Environment Variables
# ============================================
# Salin file ini menjadi .env (lokal) atau masukkan
# nilai-nilai ini ke Vercel: Settings > Environment Variables

# --- Wajib: Asisten AI (Gemini) ---
# Ambil API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=ISI_API_KEY_GEMINI_KAMU
# Opsional: model Gemini yang dipakai (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Wajib: Database (Prisma -> Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Catatan: dua variabel di atas juga dibaca oleh pipeline RAG Python
# (scripts/rag_pipeline.py & main.py) lewat file .env di root proyek,
# jadi cukup satu .env untuk keduanya.
